  {
    "name": "cascadeur_set_pose",
    "description": "Key body or finger controls in one edit. Position uses scene units, delta rotation uses degrees; rig solving can adjust values.",
    "inputSchema": {
      "$defs": {
        "Transform": {
          "additionalProperties": false,
          "properties": {
            "object": {
              "description": "Exact object ID or unique name. Prefer Point/Box rig controls.",
              "title": "Object",
              "type": "string"
            },
            "space": {
              "default": "local",
              "enum": [
                "local",
                "global"
              ],
              "title": "Space",
              "type": "string"
            },
            "position": {
              "anyOf": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Position"
            },
            "rotation_quaternion_wxyz": {
              "anyOf": [
                {
                  "maxItems": 4,
                  "minItems": 4,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rotation Quaternion Wxyz"
            },
            "rotation_delta_degrees": {
              "anyOf": [
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Post-multiply reference rotation by local XYZ delta, in degrees.",
              "title": "Rotation Delta Degrees"
            },
            "reference_frame": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Reference Frame",
              "type": "integer"
            }
          },
          "required": [
            "object"
          ],
          "title": "Transform",
          "type": "object"
        }
      },
      "properties": {
        "frame": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/Transform"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Transforms",
          "type": "array"
        },
        "interpolation": {
          "default": "BEZIER",
          "enum": [
            "BEZIER",
            "CLAMPED_BEZIER",
            "LOW_AMPLITUDE_BEZIER",
            "LINEAR",
            "STEP",
            "FIXED"
          ],
          "title": "Interpolation",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "transforms"
      ],
      "title": "cascadeur_set_poseArguments",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
